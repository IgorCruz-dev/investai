# Servidor do assistente (Python). Instalar em: /etc/systemd/system/investai.service
[Unit]
Description=InvestAI - servidor do assistente
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/investai
EnvironmentFile=/home/ubuntu/investai/.env
ExecStart=/home/ubuntu/investai/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
