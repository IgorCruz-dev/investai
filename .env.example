# Chave da Anthropic — necessária para gerar o briefing semanal (Aba 3).
# Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sua_chave_aqui

# Chave da Currents API — OPCIONAL, usada apenas como fonte de reserva de
# notícias. A fonte primária é o RSS do Google Notícias, que não exige chave.
# Crie (plano gratuito) em https://currentsapi.services/en/register
CURRENTS_API_KEY=sua_chave_aqui

# --- Opcionais (valores abaixo são os padrões) -----------------------------
# Modelo e parâmetros do briefing. ATENÇÃO: a geração Opus 5 NÃO aceita
# `temperature` (a API devolve HTTP 400); o rigor factual vem do system prompt
# e de INVESTAI_EFFORT (low | medium | high | xhigh | max).
# INVESTAI_MODEL=claude-opus-5
# INVESTAI_EFFORT=medium
# INVESTAI_MAX_TOKENS=16000
# INVESTAI_LLM_TIMEOUT=120
# INVESTAI_CONTEXT_BUDGET=8000

# Dados de mercado e notícias
# INVESTAI_PERIOD=1y            # período do histórico (1mo, 6mo, 1y, 5y...)
# INVESTAI_CACHE_TTL=3600       # validade do cache em segundos
# INVESTAI_YF_INTERVAL=0.5      # intervalo mínimo entre chamadas yfinance
# INVESTAI_NEWS_INTERVAL=0.5    # intervalo mínimo entre chamadas Currents
# INVESTAI_NEWS_PROVIDER=auto   # auto | google | currents
# INVESTAI_NEWS_DAYS=7
# INVESTAI_NEWS_PER_TICKER=5
# INVESTAI_MAX_WORKERS=4
# INVESTAI_HTTP_TIMEOUT=10

# ===========================================================================
# Assistente no WhatsApp (src/investai/whatsapp/ + apps/bridge/)
# ===========================================================================
# Segredo compartilhado com a ponte Baileys — use o MESMO valor em apps/bridge/.env
BRIDGE_SECRET=invente-uma-frase-longa
# BRIDGE_URL=http://127.0.0.1:8900

# Seu número pessoal, de onde você conversa com o assistente (só dígitos, com DDI).
# SEM ISSO, qualquer contato que escrever para o chip gasta seus créditos.
WHATSAPP_ALLOWED_NUMBERS=SEU_NUMERO_PESSOAL

INVESTAI_CRON_TOKEN=invente-outra-frase   # protege o endpoint do briefing semanal
# INVESTAI_MONTHLY_BUDGET_USD=5           # teto de gasto com a API por mês
# INVESTAI_DB=cache/investai.db

# ===========================================================================
# Banco (Neon Postgres) — a verdade sobre carteira, movimentações e perfil
# ===========================================================================
# Crie um projeto em https://neon.tech e copie a connection string.
# DUAS urls do MESMO banco, de propósito:
#   - DATABASE_URL        endpoint DIRETO, para o psycopg (VM e notebook). O
#                         pooler em modo transação derruba prepared statement,
#                         que o psycopg3 cria sozinho depois de 5 execuções.
#   - DATABASE_URL_POOLED endpoint com POOLER, para as funções serverless da
#                         Vercel (conexão curta, uma por requisição).
# A diferença entre elas é só o "-pooler" no host.
DATABASE_URL=postgresql://usuario:senha@ep-xxx.REGIAO.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://usuario:senha@ep-xxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require

# Sem DATABASE_URL o sistema lê `config/portfolio.json` como sempre leu — é o
# modo offline, e é o que os testes usam.

# ===========================================================================
# Várias pessoas na mesma instância (opcional)
# ===========================================================================
# Deixe em branco para a instância ser sua: o sistema usa a DATABASE_URL, a
# ANTHROPIC_API_KEY e a WHATSAPP_ALLOWED_NUMBERS acima, como sempre.
#
# Para compartilhar o bot e o painel com um grupo pequeno, cada pessoa tem o
# PRÓPRIO banco e a PRÓPRIA chave da Anthropic (obrigatória — não existe cair
# na chave de quem hospeda). O registro vai em `config/tenants.json` na VM; na
# Vercel, o mesmo JSON em uma linha nesta variável. Modelo em
# `config/tenants.exemplo.json`, passo a passo em `docs/deploy.md`.
#
# Quando o registro existe, ele É a lista branca do WhatsApp: a
# WHATSAPP_ALLOWED_NUMBERS acima deixa de ser consultada.
#
# --- Modo recomendado: registro num banco central ---------------------------
# Permite AUTO-INSCRIÇÃO: cada pessoa roda `python -m investai.setup` do próprio
# clone e grava a própria linha. Ninguém manda credencial para ninguém.
#
#   Se você HOSPEDA: a URL completa do banco de registro (role dona).
#   Se você está ENTRANDO numa instância: a URL de inscrição que quem hospeda
#   passou (role `investai_inscricao`, que escreve e não lê).
# INVESTAI_REGISTRY_URL=postgresql://investai_inscricao:senha@ep-registro…/neondb?sslmode=require
#
# Preenchido pelo wizard depois da inscrição — é o seu login no painel web.
# INVESTAI_TENANT_ID=
#
# --- Alternativa: registro em arquivo ou variável ---------------------------
# Para quem prefere editar à mão em vez de usar o banco central. Modelo em
# `config/tenants.exemplo.json`; na Vercel, o mesmo JSON em uma linha aqui.
# INVESTAI_TENANTS=[{"id":"igor","telefone":"5516...","database_url":"...","anthropic_key":"sk-ant-..."}]

# ===========================================================================
# Interface web (Vercel)
# ===========================================================================
# Endereço publicado. Aparece no /web e no /status do assistente.
# INVESTAI_WEB_URL=https://investai-xxxx.vercel.app

# Roteador determinístico: 1 (padrão) resolve carteira, cotação, registro de
# compra, onboarding e afins em código, sem chamar o modelo. 0 volta ao agente
# com as 8 ferramentas em toda mensagem — é a chave de rollback do deploy.
# INVESTAI_ROTEADOR=1
