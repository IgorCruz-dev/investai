# Ponte WhatsApp ↔ InvestAI
BRIDGE_PORT=8900
BRIDGE_SECRET=invente-uma-frase-longa      # o mesmo valor no .env da raiz
INVESTAI_URL=http://127.0.0.1:8000/bridge/message

# Quem pode conversar com o assistente (só dígitos, com DDI e DDD).
# Vazio = responde a QUALQUER contato que mandar mensagem para o chip.
ALLOWED_NUMBERS=SEU_NUMERO_PESSOAL

# LOG_LEVEL=info
# SEND_TIMEOUT_MS=20000
