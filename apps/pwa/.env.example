# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). As duas são credenciais públicas, feitas para ficar
# no navegador: o que protege os dados é o RLS, não o sigilo delas.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Nome novo da chave publicável. Projetos antigos ainda a chamam de anon key, e
# `src/lib/supabase.ts` aceita as duas — a publicável tem precedência.
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
# VITE_SUPABASE_ANON_KEY=sua-chave-publica
